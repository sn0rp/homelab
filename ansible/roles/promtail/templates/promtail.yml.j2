# Managed by Ansible (promtail role).
# Ships this host's logs to Loki on Hawkeye.
#
# Primary source is the rsyslog file /var/log/syslog: it always exists and is
# populated on these Debian/community-script containers and the Proxmox host,
# and (unlike the systemd journal in an unprivileged LXC) needs no special
# volume passthrough or journal permissions. We optionally ALSO read the
# journal where it is genuinely available, but the syslog tail is what keeps
# the agent healthy everywhere.

server:
  http_listen_port: {{ promtail_http_port }}
  grpc_listen_port: {{ promtail_grpc_port }}

positions:
  # Tracks how far we've read so a restart doesn't re-ship or lose lines.
  filename: /var/lib/promtail/positions.yaml

clients:
  - url: {{ promtail_loki_url }}

scrape_configs:
  # ---------------------------------------------------------------------------
  # rsyslog files: the always-present, always-populated log source on Debian.
  # Captures syslog + auth. This is the reliable primary that works identically
  # on the Proxmox host and every LXC, privileged or not.
  # ---------------------------------------------------------------------------
  - job_name: syslog
    static_configs:
      - targets: [localhost]
        labels:
          job: syslog
          host: {{ promtail_host_label }}
          __path__: /var/log/syslog

  - job_name: auth
    static_configs:
      - targets: [localhost]
        labels:
          job: auth
          host: {{ promtail_host_label }}
          __path__: /var/log/auth.log

{% if promtail_read_journal | default(false) %}
  # ---------------------------------------------------------------------------
  # systemd journal (opt-in via promtail_read_journal=true). Only enable where
  # the journal is persistent AND readable by promtail - e.g. the OpenClaw VM,
  # whose `--user` gateway service logs live in the user journal and are NOT in
  # /var/log/syslog. Left off by default because unprivileged LXCs often expose
  # no readable journal, which makes promtail report "no logs to tail".
  # ---------------------------------------------------------------------------
  - job_name: journal
    journal:
      path: {{ promtail_journal_path }}
      max_age: {{ promtail_journal_max_age }}
      json: false
      labels:
        job: systemd-journal
        host: {{ promtail_host_label }}
    relabel_configs:
      - source_labels: ['__journal__systemd_unit']
        target_label: unit
      - source_labels: ['__journal__systemd_user_unit']
        target_label: user_unit
      - source_labels: ['__journal_syslog_identifier']
        target_label: syslog_identifier
      - source_labels: ['__journal__hostname']
        target_label: nodename
{% endif %}
