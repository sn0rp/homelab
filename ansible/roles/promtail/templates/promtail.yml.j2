# Managed by Ansible (promtail role).
# Ships this host's systemd journal to Loki on Hawkeye.
#
# These hosts (community-script LXCs + the Proxmox host) run journald, NOT
# rsyslog - /var/log/syslog is an empty leftover. The systemd journal is the
# single real log source, so we read it directly. promtail must be in the
# systemd-journal group to read /var/log/journal (enforced in tasks before the
# service starts).

server:
  http_listen_port: {{ promtail_http_port }}
  grpc_listen_port: {{ promtail_grpc_port }}

positions:
  # Tracks how far we've read so a restart doesn't re-ship or lose lines.
  filename: /var/lib/promtail/positions.yaml

clients:
  - url: {{ promtail_loki_url }}

scrape_configs:
  # ---------------------------------------------------------------------------
  # systemd journal: the only populated log source on these journald-only boxes.
  # Reads /var/log/journal (persistent). Captures system units, kernel, auth,
  # and - because we read the whole journal tree - per-user units too, which is
  # where OpenClaw's `--user` gateway service logs land.
  # ---------------------------------------------------------------------------
  - job_name: journal
    journal:
      path: {{ promtail_journal_path }}
      max_age: {{ promtail_journal_max_age }}
      json: false
      labels:
        job: systemd-journal
        host: {{ promtail_host_label }}
    relabel_configs:
      # Promote the systemd unit to a queryable label, e.g.
      #   {host="hawkeye", unit="prometheus.service"}
      - source_labels: ['__journal__systemd_unit']
        target_label: unit
      # User-session units (OpenClaw's --user service) expose the unit here.
      - source_labels: ['__journal__systemd_user_unit']
        target_label: user_unit
      # Process/identifier for non-unit lines.
      - source_labels: ['__journal_syslog_identifier']
        target_label: syslog_identifier
      - source_labels: ['__journal__hostname']
        target_label: nodename
    pipeline_stages:
      # CRITICAL: drop the monitoring stack's own logs. Loki's ruler logs every
      # rule evaluation INCLUDING the full LogQL query text - which contains the
      # exact phrases our alert rules hunt for ("oom-kill:", "entered failed
      # state", "Failed password"). Shipping that back into Loki makes the rules
      # match their own evaluation logs => infinite self-triggering false
      # alerts. Drop the monitoring plumbing's own journal entirely.
      #
      # Uses the `drop` stage matching on the `unit` / `syslog_identifier`
      # labels set by relabel_configs above (more robust than a `match` stage
      # with a LogQL selector, which validates labels at parse time and refuses
      # to start if anything is off).
      - drop:
          source: unit
          expression: '(loki|promtail|alertmanager|prometheus|grafana-server|blackbox_exporter|graphite_exporter)\.service'
          drop_counter_reason: monitoring_self_log
      - drop:
          source: syslog_identifier
          expression: '(loki|promtail|alertmanager|prometheus)'
          drop_counter_reason: monitoring_self_log
