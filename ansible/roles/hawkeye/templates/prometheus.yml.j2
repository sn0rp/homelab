# Managed by Ansible (hawkeye role).
global:
  scrape_interval: {{ scrape_interval }}
  evaluation_interval: {{ scrape_interval }}

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["127.0.0.1:9093"]

scrape_configs:
  # Prometheus self
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]

  # ICMP reachability probes via blackbox. Targets come from file-SD:
  #   static.yml       -> router_lan + public_anchor
  #   isp_gateway.yml  -> dynamically discovered Spectrum gateway
  - job_name: blackbox_icmp
    metrics_path: /probe
    params:
      module: [icmp_v4]
    file_sd_configs:
      - files:
          - /etc/prometheus/targets/static.yml
          - /etc/prometheus/targets/isp_gateway.yml
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9115

  # Hawkeye's own node_exporter (textfile collector) - serves the NAS disk
  # temps + ZFS pool health that the watchdog writes (Graphite lacks them).
  - job_name: node_hawkeye
    static_configs:
      - targets: ["127.0.0.1:9100"]
        labels:
          host: "hawkeye"

  # Proxmox host node_exporter (CPU/RAM/temps/disk/SMART textfile).
  - job_name: node_proxmox
    static_configs:
      - targets: ["{{ proxmox_ip }}:9100"]
        labels:
          host: "proxmox"

  # Proxmox VE exporter (per-VM/LXC + node + storage).
  - job_name: pve
    static_configs:
      - targets: ["{{ proxmox_ip }}:9221"]
    metrics_path: /pve
    params:
      module: [default]
      cluster: ["1"]
      node: ["1"]

  # TrueNAS metrics, via graphite_exporter (TrueNAS pushes Graphite -> :2003,
  # exporter re-exposes Prometheus on :9108). honor_labels so the host label
  # from the mapping config is preserved.
  - job_name: truenas_graphite
    honor_labels: true
    static_configs:
      - targets: ["127.0.0.1:{{ graphite_metrics_port }}"]

  # Application-layer internet check: TCP+TLS to a public anchor.
  - job_name: blackbox_tcp_internet
    metrics_path: /probe
    params:
      module: [tcp_connect]
    static_configs:
      - targets: ["1.1.1.1:443"]
        labels:
          probe_role: "internet_app"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9115
