#!/usr/bin/env bash
# Managed by Ansible (homelab role: hawkeye)
#
# Discovers the current Spectrum WAN gateway WITHOUT hardcoding 98.26.78.1 and
# WITHOUT running any agent on the router. The Spectrum gateway is NOT visible
# from inside this LXC (we sit behind the router, and the gateway does not
# answer traceroute - hop 2 is a silent "*"). It only appears in the router's
# OWN routing table. So we do a lightweight READ over SSH:
#     ssh root@<router> ip route show default   ->   "default via 98.26.78.1 ..."
#
# Output: a Prometheus file-SD JSON at /etc/prometheus/targets/isp_gateway.yml.
# On failure (router unreachable, or value not public) we do NOT overwrite the
# last-known-good file - the stale target stays so blackbox keeps probing the
# last known gateway and correctly reports it down. If the file never existed
# (first run failed), there is simply no isp_gateway probe, which is honest:
# better an absent probe than a fake one pointing at 1.1.1.1.

set -euo pipefail

ROUTER="{{ router_lan_ip }}"
OUT="/etc/prometheus/targets/isp_gateway.yml"
SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=5"
TMP="$(mktemp)"

is_public() {
  local ip="$1"
  case "$ip" in
    10.*|192.168.*|127.*|169.254.*|0.*) return 1 ;;
    172.1[6-9].*|172.2[0-9].*|172.3[0-1].*) return 1 ;;
    100.6[4-9].*|100.[7-9][0-9].*|100.1[0-1][0-9].*|100.12[0-7].*) return 1 ;;
    "") return 1 ;;
    *) return 0 ;;
  esac
}

# Read the router's default-route gateway (the Spectrum edge) over SSH.
route_line="$(ssh $SSH_OPTS "root@${ROUTER}" 'ip route show default' 2>/dev/null || true)"
gw="$(echo "$route_line" | grep -oE 'via ([0-9]{1,3}\.){3}[0-9]{1,3}' | awk '{print $2}' | head -n1 || true)"

if [ -n "$gw" ] && is_public "$gw"; then
  cat > "$TMP" <<EOF
- targets:
    - "$gw"
  labels:
    probe_role: "isp_gateway"
EOF
  install -m 0644 -o prometheus -g prometheus "$TMP" "$OUT"
  rm -f "$TMP"
  echo "discovered Spectrum gateway: $gw"
else
  rm -f "$TMP"
  echo "discovery failed (router unreachable or gateway not public: '${gw:-none}'); keeping last-known target" >&2
  exit 0
fi
