# Managed by Ansible (hawkeye role). Loki ruler LogQL alert rules.
#
# Log-based alerts that metrics cannot see, fired to the same Alertmanager that
# routes Prometheus alerts to Discord. outage_class=logs routes them to the
# discord-logs receiver, with the summary/description annotations Alertmanager's
# discord_configs renders into the embed.
#
# IMPORTANT - self-trigger guard: Loki's ruler logs every rule evaluation, and
# that log line contains the full LogQL query text (including the very phrases
# these rules hunt for). The promtail role drops the monitoring stack's own
# journal (loki/promtail/alertmanager/prometheus units) so those lines never
# reach Loki. As a SECOND layer of defense, every rule below also excludes any
# line mentioning systemd-journal/ruler/query echoes, so a stray monitoring log
# can never self-trigger an alert.

groups:
  # -------------------------------------------------------------------------
  # SSH auth failures / brute force
  # -------------------------------------------------------------------------
  # NOTE on thresholds: each failed SSH attempt emits SEVERAL journal lines
  # (Failed password + PAM auth failure + Connection closed, etc). A handful of
  # mistyped logins easily produces 20+ lines, so thresholds are set well above
  # incidental fat-fingering - a real brute-force produces hundreds per minute.
  - name: logs_ssh
    rules:
      - alert: SshBruteForce
        expr: |
          sum by (host) (
            count_over_time(
              {job="systemd-journal"} |~ "(?i)sshd"
              |~ "(?i)(Failed password|Invalid user|authentication failure|Failed publickey)"
              != "query"
              [5m]
            )
          ) > 100
        for: 2m
        labels:
          severity: critical
          outage_class: logs
        annotations:
          summary: "SSH brute-force on {{ '{{' }} $labels.host {{ '}}' }}"
          description: "Over 100 SSH auth-failure log lines in 5m on {{ '{{' }} $labels.host {{ '}}' }}. Almost certainly a brute-force - check source IPs and consider blocking at the router."

      - alert: SshFailureSpike
        expr: |
          sum by (host) (
            count_over_time(
              {job="systemd-journal"} |~ "(?i)sshd"
              |~ "(?i)(Failed password|Invalid user)"
              != "query"
              [10m]
            )
          ) > 30
        for: 5m
        labels:
          severity: warning
          outage_class: logs
        annotations:
          summary: "Elevated SSH auth failures on {{ '{{' }} $labels.host {{ '}}' }}"
          description: "More than 30 SSH auth-failure log lines in 10m on {{ '{{' }} $labels.host {{ '}}' }}. Not yet brute-force territory, but worth a look."

  # -------------------------------------------------------------------------
  # systemd units entering failed state
  # -------------------------------------------------------------------------
  - name: logs_systemd
    rules:
      # Anchored to systemd's real failure line format:
      #   "<unit>.service: Failed with result '<reason>'."
      #   "<unit>.service: Start request repeated too quickly."
      # The "\\.service:" anchor means it only matches an actual unit-status
      # line, not arbitrary text containing the word "failed". The != filters
      # exclude monitoring/query echoes AND the monitoring stack's own units
      # (promtail/loki/etc) - a promtail restart blip logs "promtail.service:
      # Failed with result" and we do not want to page ourselves for the
      # monitoring plumbing recovering.
      #
      # ALSO excluded: snapd's firmware-updater notifier oneshots. On a headless
      # box these run on a snap timer, have no user session/display to notify,
      # and exit nonzero EVERY cycle - logging ".service: Failed with result"
      # then leaving no persistent failed state (systemctl --failed is clean).
      # This was the source of ~98% of the phantom "failed then resolved a
      # minute later" pages (57 lines/24h, 56 of them this one snap unit).
      # Confirmed via Loki 2026-07-10. We drop the whole snap.* namespace since
      # snap oneshots self-recover and are not the kind of failure we act on.
      - alert: SystemdUnitFailed
        expr: |
          sum by (host) (
            count_over_time(
              {job="systemd-journal"}
              |~ `\.service: (Failed with result|Start request repeated too quickly)`
              != "query"
              != "count_over_time"
              !~ `(loki|promtail|alertmanager|prometheus|grafana-server|blackbox_exporter|graphite_exporter)\.service`
              !~ `snap\.[\w.-]+\.service`
              [5m]
            )
          ) > 0
        for: 1m
        labels:
          severity: critical
          outage_class: logs
        annotations:
          summary: "systemd unit failed on {{ '{{' }} $labels.host {{ '}}' }}"
          description: "A systemd unit entered a failed state on {{ '{{' }} $labels.host {{ '}}' }} in the last 5m. Run 'systemctl --failed' and 'journalctl -p err -b' on that host."

  # -------------------------------------------------------------------------
  # OOM kills - the silent homelab killer
  # -------------------------------------------------------------------------
  - name: logs_oom
    rules:
      # Anchored to the kernel's real OOM line, which always names a killed PID:
      #   "Out of memory: Killed process 1234 (name) ..."
      #   "oom-kill:constraint=..."
      # Requiring the PID/constraint context after the phrase means a log line
      # that merely quotes the phrase (like a query echo) will not match. The
      # != filters are a second backstop.
      - alert: OutOfMemoryKill
        expr: |
          sum by (host) (
            count_over_time(
              {job="systemd-journal"}
              |~ `(Out of memory: Killed process [0-9]+|oom-kill:constraint=|invoked oom-killer:)`
              != "query"
              != "count_over_time"
              [5m]
            )
          ) > 0
        for: 1m
        labels:
          severity: critical
          outage_class: logs
        annotations:
          summary: "OOM kill on {{ '{{' }} $labels.host {{ '}}' }}"
          description: "The kernel OOM killer reaped a process on {{ '{{' }} $labels.host {{ '}}' }}. Something over-committed memory - check which service died and its limits."
