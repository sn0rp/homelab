# Managed by Ansible (hawkeye role).
# graphite_exporter mapping: TrueNAS Community Edition (netdata-based reporting)
# Graphite metric names -> Prometheus.
#
# IMPORTANT: TrueNAS CE uses NETDATA for reporting, not collectd. The namespace
# is flat: <chart>.<dimension>.<field>  (NO "servers." prefix, NO hostname).
# Confirmed live 2026-06-22 against nas.snorp.dev. The chart families present:
#   cputemp, net, net_carrier, net_drops, net_duplex, net_mtu, net_operstate,
#   net_packets, net_speed, netdata, services, system,
#   truenas_arcstats, truenas_cpu_usage, truenas_disk_stats, truenas_meminfo
#
# NOTE: this stream does NOT include disk temperatures, SMART, or ZFS pool
# health (ONLINE/DEGRADED). Those safety-critical signals - including the
# Ironwolf 60C temp alert and the loose-SATA-cable pool-degraded watchdog - are
# handled separately via a TrueNAS-side midclt watchdog (see nas_watchdog).
#
# Validate:
#   graphite_exporter --check-config \
#     --graphite.mapping-config=/etc/graphite_exporter_mapping.yml

mappings:
  # ---- CPU temperature (per core + aggregate). cputemp.temperatures.cpuN ----
  - match: 'cputemp\.temperatures\.(.*)'
    match_type: regex
    name: 'truenas_cpu_temperature_celsius'
    labels:
      host: 'nas'
      cpu: '${1}'

  # ---- CPU usage. truenas_cpu_usage.<something>.<mode> ----
  - match: 'truenas_cpu_usage\.(.*)\.(.*)'
    match_type: regex
    name: 'truenas_cpu_usage'
    labels:
      host: 'nas'
      cpu: '${1}'
      mode: '${2}'

  # ---- Memory. truenas_meminfo.<dim>.<field> ----
  - match: 'truenas_meminfo\.(.*)\.(.*)'
    match_type: regex
    name: 'truenas_memory_${2}'
    labels:
      host: 'nas'
      kind: '${1}'

  # ---- ZFS ARC stats. truenas_arcstats.<dim>.<field> ----
  - match: 'truenas_arcstats\.(.*)\.(.*)'
    match_type: regex
    name: 'truenas_arc_${2}'
    labels:
      host: 'nas'
      kind: '${1}'

  # ---- Per-disk I/O stats. truenas_disk_stats.<device>.<field> ----
  - match: 'truenas_disk_stats\.(.*)\.(.*)'
    match_type: regex
    name: 'truenas_disk_${2}'
    labels:
      host: 'nas'
      device: '${1}'

  # ---- Network throughput. net.<iface>.received|sent ----
  - match: 'net\.(.*)\.(.*)'
    match_type: regex
    name: 'truenas_net_${2}'
    labels:
      host: 'nas'
      interface: '${1}'

  # ---- Network carrier state. net_carrier.<iface>.up|down ----
  - match: 'net_carrier\.(.*)\.(.*)'
    match_type: regex
    name: 'truenas_net_carrier'
    labels:
      host: 'nas'
      interface: '${1}'
      state: '${2}'

  # ---- Network packets. net_packets.<iface>.<field> ----
  - match: 'net_packets\.(.*)\.(.*)'
    match_type: regex
    name: 'truenas_net_packets_${2}'
    labels:
      host: 'nas'
      interface: '${1}'

  # ---- System chart (uptime, processes, etc). system.<dim>.<field> ----
  - match: 'system\.(.*)\.(.*)'
    match_type: regex
    name: 'truenas_system_${1}'
    labels:
      host: 'nas'
      field: '${2}'

  # ---- Per-service CPU. services.cpu.<service> ----
  - match: 'services\.cpu\.(.*)'
    match_type: regex
    name: 'truenas_service_cpu'
    labels:
      host: 'nas'
      service: '${1}'

  # ---- CATCH-ALL: retain anything not explicitly mapped so the namespace
  #      stays inspectable. Full dotted path in the graphite_name label. ----
  - match: '(.*)'
    match_type: regex
    name: 'truenas_unmapped'
    labels:
      graphite_name: '${1}'
