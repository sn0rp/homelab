# Managed by Ansible (hawkeye role).
# Routes alerts to Discord via native discord_configs (Alertmanager >= 0.25).
#
# MIGRATED OFF ntfy 2026-07-10: ntfy required a phone app and only delivered on
# the LAN (the phone subscribed over WiFi). Discord webhooks reach you on or off
# the network with no extra app. Alertmanager's native discord_configs formats
# the webhook payload itself (title/description/color by firing|resolved), so we
# no longer need the percent-encoded ntfy template hack that used to live here.
#
# Two receivers so outage vs log alerts stay visually distinct and can point at
# different channels if desired. Webhook URLs come from vault (see vault.yml:
# discord_outage_webhook / discord_logs_webhook) - never commit them plaintext.

global:
  resolve_timeout: 1m

route:
  receiver: discord-outage
  group_by: ["outage_class"]
  group_wait: 10s
  group_interval: 30s
  # Re-notify every 30m during a sustained outage so you are reminded.
  repeat_interval: 30m
  routes:
    # Log-based alerts (Loki ruler) -> logs receiver. MUST come before the
    # severity=critical route below, since these are also critical; first-match
    # wins in Alertmanager, so the more specific outage_class match has to be
    # listed first or log alerts would land on the outage receiver.
    - matchers:
        - outage_class = "logs"
      receiver: discord-logs
      group_by: ["host", "alertname"]
      # Logs are bursty; don't re-nag as aggressively as an outage.
      repeat_interval: 2h
    - matchers:
        - severity = "critical"
      receiver: discord-outage

receivers:
  # Outage + infra alerts -> primary alerts channel. title branches firing vs
  # resolved via the standard Alertmanager template funcs; discord_configs sets
  # the embed color (red firing / green resolved) automatically.
  - name: discord-outage
    discord_configs:
      - webhook_url: "{{ discord_outage_webhook }}"
        send_resolved: true
        title: '{% raw %}{{ if eq .Status "firing" }}🔴 OUTAGE: {{ else }}🟢 RESOLVED: {{ end }}{{ (index .Alerts 0).Annotations.summary }}{% endraw %}'
        message: '{% raw %}{{ range .Alerts }}{{ .Annotations.description }}{{ "\n" }}{{ end }}{% endraw %}'

  # Log-based alerts (Loki ruler) -> logs channel (may be the same webhook).
  - name: discord-logs
    discord_configs:
      - webhook_url: "{{ discord_logs_webhook }}"
        send_resolved: true
        title: '{% raw %}{{ if eq .Status "firing" }}🟠 LOG ALERT: {{ else }}🟢 RESOLVED: {{ end }}{{ (index .Alerts 0).Annotations.summary }}{% endraw %}'
        message: '{% raw %}{{ range .Alerts }}{{ .Annotations.description }}{{ "\n" }}{{ end }}{% endraw %}'
